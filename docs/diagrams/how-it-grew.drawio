<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="first-read" name="1. First read"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="first-read-t1" value="First read of the brief, and how the plan came together" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="first-read-v2" value="&lt;b&gt;The brief, first read&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 200–500 incidents; generator + fixed seed&lt;br&gt;• POST /ingest: idempotent, returns counts&lt;br&gt;• GET /search: q + filters, top N, total&lt;br&gt;• GET /incidents/{id}: full record&lt;br&gt;• POST /assist: same search path (tool:search),&lt;br&gt;   real LLM, 3–5 cited ids, next steps, customer draft&lt;br&gt;• Hard rules: cite ids, invent nothing, say when&lt;br&gt;   nothing is found, clear errors when the LLM fails&lt;br&gt;• correlation_id on every log line + a step log&lt;br&gt;• Validation, timeouts, limits; ≥2 unit tests&lt;br&gt;• README, PROMPTS, AI-NOTES, TRADEOFFS&lt;br&gt;&lt;br&gt;Graded on: steering AI to clean code,&lt;br&gt;and handling AI mistakes + edge cases." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="420" as="geometry"/></mxCell><mxCell id="first-read-v3" value="&lt;b&gt;How the plan was made (before any code)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Four agents planned independently: 1.md–4.md&lt;br&gt;2. Claude Code compared the four&lt;br&gt;3. Two more agents reviewed all four&lt;br&gt;4. Merged into one plan (4.md as the base)&lt;br&gt;5. Same two agents reviewed it again&lt;br&gt;6. → docs/PLAN.md (56 tracked review points)&lt;br&gt;&lt;br&gt;Bugs caught before code existed:&lt;br&gt;• id scan INC-\d{5} misses INC-9999&lt;br&gt;• :memory: test DB is empty per request&lt;br&gt;• tags=db&amp;amp;tags=db returns nothing&lt;br&gt;• LLM_TEMPERATURE=none crashes startup&lt;br&gt;• text could name an incident the checks dropped" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="420" height="420" as="geometry"/></mxCell><mxCell id="first-read-e4" value="plan before code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v2" target="first-read-v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-v5" value="&lt;b&gt;HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;/ingest · /search · /incidents/{id} · /assist · /debug/trace · /health" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="660" height="60" as="geometry"/></mxCell><mxCell id="first-read-v6" value="&lt;b&gt;CorrelationIdMiddleware&lt;/b&gt;&lt;br&gt;&lt;br&gt;ContextVar · JSON logs (filter on the root handler) · 500s keep the id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="660" height="60" as="geometry"/></mxCell><mxCell id="first-read-v7" value="&lt;b&gt;IngestService&lt;/b&gt;&lt;br&gt;&lt;br&gt;hash → add / update / skip&lt;br&gt;BEGIN IMMEDIATE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="270" width="200" height="90" as="geometry"/></mxCell><mxCell id="first-read-v8" value="&lt;b&gt;SearchService&lt;/b&gt;&lt;br&gt;&lt;br&gt;the single search path&lt;br&gt;quoted FTS5 terms, BM25" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="270" width="200" height="90" as="geometry"/></mxCell><mxCell id="first-read-v9" value="&lt;b&gt;AssistService&lt;/b&gt;&lt;br&gt;&lt;br&gt;gate → context → LLM&lt;br&gt;→ guardrails" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1450" y="270" width="200" height="90" as="geometry"/></mxCell><mxCell id="first-read-v10" value="&lt;b&gt;SQLite FTS5&lt;/b&gt;&lt;br&gt;&lt;br&gt;incidents · tags · fts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="410" width="200" height="70" as="geometry"/></mxCell><mxCell id="first-read-v11" value="&lt;b&gt;Guardrails (pure)&lt;/b&gt;&lt;br&gt;&lt;br&gt;cited ids only · verified quotes&lt;br&gt;facts from the DB" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1330" y="410" width="160" height="90" as="geometry"/></mxCell><mxCell id="first-read-v12" value="&lt;b&gt;LLMClient&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenAI / Azure&lt;br&gt;strict JSON schema" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1510" y="410" width="140" height="90" as="geometry"/></mxCell><mxCell id="first-read-e13" value="initial design" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v3" target="first-read-v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v5" target="first-read-v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v7" target="first-read-v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v8" target="first-read-v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e17" value="tool:search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v9" target="first-read-v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v9" target="first-read-v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="first-read-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="first-read-v9" target="first-read-v12"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="how-it-grew" name="2. How it grew"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="how-it-grew-t1" value="How it grew, commit by commit (who decided is marked)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="how-it-grew-v2" value="&lt;b&gt;4fb5cce · setup, plan, planning trail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: uv + Python 3.12 pin, CLAUDE.md house rules,&lt;br&gt;docs/PLAN.md, docs/planning/, notes/ai-log.md&lt;br&gt;Edge cases: system python is 3.9; the key lives only in&lt;br&gt;the gitignored .env, leak check before every push&lt;br&gt;Decided: Claude (phase 0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v3" value="&lt;b&gt;43a214c · skeleton: ids, logs, errors&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: settings, correlation middleware, JSON logs,&lt;br&gt;error envelope, 413 limit, /health, python -m app&lt;br&gt;Edge cases: crashes keep the id; bad header replaced,&lt;br&gt;never logged; uvicorn color_message leak (real run)&lt;br&gt;Tests: 16 · Decided: Claude (phase 1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v4" value="&lt;b&gt;ff7d421 · LLM adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: typed errors, OpenAI/Azure adapter,&lt;br&gt;not-configured client, make smoke&lt;br&gt;Edge cases: openai v3 runs on httpx2 → timeout fix;&lt;br&gt;timeout ⊂ connection error; retries at DEBUG → logged&lt;br&gt;Tests: 37 · My calls: gpt-4o-mini, log attempts, httpx2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v5" value="&lt;b&gt;08d3084 · data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: Incident model, seeded generator,&lt;br&gt;golden.json, 12-record test fixture&lt;br&gt;Edge cases: byte-identical output; unpadded hour;&lt;br&gt;env skew was seed noise, not a bug; injection ticket&lt;br&gt;Tests: 52 · My calls: exact 40/20/20/20, clusters, vague" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v6" value="&lt;b&gt;89af41b · store, ingest, search&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: FTS5 schema, idempotent ingest, query builder,&lt;br&gt;match=auto, unknown params → 422&lt;br&gt;Edge cases: FTS syntax injection; duplicate tags;&lt;br&gt;flaky concurrency test (3/5) → barrier (5/5)&lt;br&gt;Tests: 78 · My call: 12 candidates (recall 15→18/20)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v7" value="&lt;b&gt;9cf5f64 · grounded /assist&lt;/b&gt;&lt;br&gt;&lt;br&gt;Added: prompt, strict schema, context budget,&lt;br&gt;guardrails, zero-hit gate, repair call, /debug/trace&lt;br&gt;Edge cases: model says nothing relevant; text names&lt;br&gt;a dropped incident; ids in the customer draft&lt;br&gt;Tests: 96, guardrail tests first; live 7/7 · My calls" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v8" value="&lt;b&gt;7e7df18 · fixes from an independent review&lt;/b&gt;&lt;br&gt;&lt;br&gt;A second model (Sonnet) reviewed cold: 14 findings, 13 real&lt;br&gt;Edge cases: lookalike-dash ids; ids in quotes and&lt;br&gt;questions; tests that couldn&amp;#x27;t fail; empty usage → 500&lt;br&gt;Added: one sanitizer, hard-cap deadline, /health 503&lt;br&gt;Tests: 131; live 7/7 · My calls: fix all 13, audit trail" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-v9" value="&lt;b&gt;docs · README, PROMPTS, AI-NOTES, TRADEOFFS&lt;/b&gt;&lt;br&gt;&lt;br&gt;README commands run as written; this diagram;&lt;br&gt;fresh-clone check: uv sync, make test, curls&lt;br&gt;&lt;br&gt;Time: ~1 h 10 min planning + ~1 h 25 min build,&lt;br&gt;about 2.5 h of working time" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1330" y="650" width="400" height="300" as="geometry"/></mxCell><mxCell id="how-it-grew-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v2" target="how-it-grew-v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v3" target="how-it-grew-v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v4" target="how-it-grew-v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v5" target="how-it-grew-v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v6" target="how-it-grew-v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v7" target="how-it-grew-v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="how-it-grew-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="how-it-grew-v8" target="how-it-grew-v9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
