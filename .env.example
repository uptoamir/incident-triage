# Copy to .env and fill in. Only the LLM_* lines are needed to get /assist working.

# --- LLM ---
LLM_PROVIDER=openai                # openai | azure-openai
LLM_API_KEY=                       # required for /assist
LLM_MODEL=gpt-4o-mini              # for azure-openai this is your deployment name
# LLM_BASE_URL=                    # optional OpenAI-compatible endpoint
# AZURE_OPENAI_ENDPOINT=           # azure-openai only
# AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_JSON_MODE=json_schema        # json_schema | json_object (fallback for models without strict schemas)
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=1
# LLM_TEMPERATURE=0                # set to none for models that reject temperature
# LLM_MAX_OUTPUT_TOKENS=1000

# --- server / logging ---
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# LOG_FORMAT=json                  # json | text
# LOG_LLM_PAYLOADS=false           # local debugging only

# --- data ---
# DATA_PATH=data/incidents.json
# DB_PATH=var/incidents.db

# --- limits ---
# SEARCH_DEFAULT_LIMIT=10
# SEARCH_MAX_LIMIT=50
# SEARCH_MAX_QUERY_CHARS=2000
# SEARCH_MAX_TERMS=16
# ASSIST_CANDIDATES=8
# ASSIST_MAX_QUESTION_CHARS=2000
# ASSIST_MAX_CONTEXT_CHARS=12000
# ASSIST_DEADLINE_SECONDS=45
# GUARDRAIL_MODE=strict            # strict | lenient
# INGEST_MAX_RECORDS=1000
# MAX_REQUEST_BYTES=5242880
# DEBUG_ENDPOINTS_ENABLED=true
# TRACE_STORE_MAX=500
